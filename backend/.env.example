# LifeGraph Backend Configuration

PORT=3001
CORS_ORIGIN=http://localhost:3000

# Optional: PostgreSQL Database URL (If omitted, runs with In-Memory Simulation DB)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/lifegraph

# Optional: Gemini API Key for Live AI Game Master (If omitted, uses Procedural AI Engine)
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
