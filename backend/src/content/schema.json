{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LifeGraphContentPack",
  "type": "object",
  "required": ["pack_id", "name", "version", "description", "scenarios"],
  "properties": {
    "pack_id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "arc_id", "stage", "title", "location_id", "scenes", "prerequisites", "choices"],
        "properties": {
          "id": { "type": "string" },
          "arc_id": { "type": "string" },
          "stage": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "location_id": { "type": "string" },
          "roles": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "prerequisites": {
            "type": "object",
            "properties": {
              "min_age": { "type": "integer" },
              "max_age": { "type": "integer" },
              "required_flags": { "type": "array", "items": { "type": "string" } },
              "excluded_flags": { "type": "array", "items": { "type": "string" } },
              "required_knowledge": { "type": "array", "items": { "type": "string" } },
              "era": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "fate_thread": { "type": "string" },
              "requires_npc": {
                "type": "object",
                "required": ["role"],
                "properties": { "role": { "type": "string" }, "memory_has": { "type": "string" } }
              },
              "min_quality": { "type": "object", "additionalProperties": { "type": "number" } }
            }
          },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "cooldown_years": { "type": "integer", "minimum": 0 },
          "group": { "type": "string" },
          "locks": { "type": "array", "items": { "type": "string" } },
          "unlocks": { "type": "array", "items": { "type": "string" } },
          "scenes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "background_theme", "hotspots"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "background_theme": { "type": "string" },
                "hotspots": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "label", "icon", "position_x", "dialogue"],
                    "properties": {
                      "id": { "type": "string" },
                      "label": { "type": "string" },
                      "icon": { "type": "string" },
                      "position_x": { "type": "number" },
                      "npc_role": { "type": "string" },
                      "dialogue": {
                        "type": "object",
                        "required": ["speaker", "text"],
                        "properties": {
                          "speaker": { "type": "string" },
                          "text": { "type": "string" },
                          "granted_knowledge": { "type": "string" },
                          "affinity_delta": { "type": "number" },
                          "trust_delta": { "type": "number" },
                          "cost_ap": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "mind_stage": {
            "type": "object",
            "properties": {
              "whispers": {
                "type": "object",
                "properties": {
                  "rational": { "type": "string" },
                  "empathy": { "type": "string" },
                  "instinct": { "type": "string" }
                }
              }
            }
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "stance", "description"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "stance": { "type": "string" },
                "description": { "type": "string" },
                "knowledge_requirements": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "cost_ap": { "type": "integer" },
                "check": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string" },
                    "stat": { "type": "string" },
                    "target_dc": { "type": "integer" },
                    "bonus_traits": { "type": "array", "items": { "type": "string" } }
                  }
                },
                "outcomes": {
                  "type": "object",
                  "properties": {
                    "critical_success": { "type": "object" },
                    "success": { "type": "object" },
                    "failure": { "type": "object" }
                  }
                },
                "effects": { "type": "object" },
                "delayed_effects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "trigger_after_ticks", "description", "effects"],
                    "properties": {
                      "id": { "type": "string" },
                      "trigger_after_ticks": { "type": "integer" },
                      "description": { "type": "string" },
                      "effects": { "type": "object" }
                    }
                  }
                },
                "commitments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "to_npc", "title", "due_ticks"],
                    "properties": {
                      "id": { "type": "string" },
                      "to_npc": { "type": "string" },
                      "title": { "type": "string" },
                      "due_ticks": { "type": "integer" },
                      "consequence_on_break": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
